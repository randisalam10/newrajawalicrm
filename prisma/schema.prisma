generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleScope {
  ALL_BRANCHES
  OWN_BRANCH
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  label       String
  description String?
  isSystem    Boolean          @default(false)
  scope       RoleScope        @default(OWN_BRANCH)
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  module      String
  action      String
  name        String
  description String?
  roles       RolePermission[]

  @@index([module])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

enum Position {
  Sopir
  Operator
  Admin
  AdminLogistik
  CEO
  FVP
  Approver
}

enum EmployeeStatus {
  Active
  Inactive
}

enum VehicleType {
  Mixer
  Loader
}

enum CustomerStatus {
  Active
  Inactive
}

enum TransactionStatus {
  Pending
  Confirmed
}

enum MaterialType {
  Semen
  Pasir
}

enum AggregateSourceType {
  Internal // Quarry sendiri
  External // Pembelian dari luar
}

enum AggregateType {
  SplitHalfOne // Batu Split 1/2
  SplitTwoThree // Batu Split 2/3
  Pasir // Pasir
  Semen // Semen
  Other // Lainnya
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  CANCELLED
}

enum PlanStatus {
  Planned
  OnGoing
  Done
  Cancelled
}

enum PaymentMethod {
  TRANSFER
  CASH
  GIRO
  DEPOSIT
}

enum BillingAction {
  INVOICE_CREATED
  INVOICE_ISSUED
  INVOICE_CANCELLED
  PAYMENT_RECORDED
  PAYMENT_CANCELLED
  DEPOSIT_ADDED
  DEPOSIT_USED
}

model User {
  id         String     @id @default(uuid())
  username   String     @unique
  password   String
  role       String
  roleId     String?
  roleRef    Role?      @relation(fields: [roleId], references: [id])
  fcmToken   String?    // Added for Mobile Push Notifications
  employee   Employee   @relation(fields: [employeeId], references: [id])
  employeeId String     @unique
  auditLogs  AuditLog[]

  signatureUrl        String?          // URL / path TTD tersimpan approver
  poSubmitted         PurchaseOrder[]  @relation("PoSubmittedBy")
  poRejected          PurchaseOrder[]  @relation("PoRejectedBy")

  // Multi-Level Approval Relations
  defaultCeos PoCompanyGroup[] @relation("CompanyCeo")
  defaultFvps PoCompanyGroup[] @relation("CompanyFvp")
  poCeos      PurchaseOrder[]  @relation("PoCeo")
  poFvps      PurchaseOrder[]  @relation("PoFvp")
  poApprovedBy PurchaseOrder[] @relation("PoApprovedBy")
  poCeoApprovedBy PurchaseOrder[] @relation("PoCeoApprovedBy")
  poFvpApprovedBy PurchaseOrder[] @relation("PoFvpApprovedBy")

  // RBL Relations
  rblBudgetsCreated   RblBudget[]     @relation("RblBudgetCreatedBy")
  rblBudgetsClosed    RblBudget[]     @relation("RblBudgetClosedBy")
  rblExpensesCreated  RblExpense[]    @relation("RblExpenseCreatedBy")
  rblAttachments      RblAttachment[] @relation("RblAttachmentUploadedBy")

  // Master Item Price History
  masterItemPriceHistories MasterItemPriceHistory[] @relation("PriceHistoryUpdatedBy")

  // Web Push Subscriptions
  webPushSubscriptions WebPushSubscription[]
}

model WebPushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Employee {
  id                         String                  @id @default(uuid())
  name                       String
  position                   Position
  status                     EmployeeStatus          @default(Active)
  join_date                  DateTime
  user                       User?
  location                   Location?               @relation(fields: [locationId], references: [id])
  locationId                 String?
  driverCategoryId           String?
  driverCategory             DriverCategory?         @relation(fields: [driverCategoryId], references: [id])
  driver_transactions        ProductionTransaction[] @relation("SopirRelation")
  operator_transactions      ProductionTransaction[] @relation("OperatorRelation")
  operator_bp_transactions   ProductionTransaction[] @relation("ProductionOperator")
  operator_sewa_transactions SewaTransaction[]       @relation("OperatorSewaRelation")
  retase_commissions         Retase[]                @relation("DriverRetase")
  driver_aggregate_incomings AggregateIncoming[]     @relation("DriverAggregate")
  driver_aggregate_outgoings AggregateOutgoing[]     @relation("DriverAggregateOutgoing")

  @@index([driverCategoryId])
}

model Location {
  id                     String                  @id @default(uuid())
  name                   String                  @unique
  employees              Employee[]
  vehicles               Vehicle[]
  customers              Customer[]              @relation("CustomerOwner") // Changed
  workItems              WorkItem[]
  concreteQualities      ConcreteQuality[]
  transactions           ProductionTransaction[]
  materialIncomings      MaterialIncoming[]
  aggregateIncomings     AggregateIncoming[]
  aggregateOutgoings     AggregateOutgoing[]
  retaseSetting          RetaseSetting?
  aggregateRetaseSetting AggregateRetaseSetting?
  invoices               Invoice[]
  concretePlans          ConcretePlan[]
  sharedCustomers        Customer[]              @relation("CustomerSharedLocations") // Added
  sharedProjects         Project[]               @relation("ProjectSharedLocations") // Added
  purchaseOrders         PurchaseOrder[]
  rblBudgets             RblBudget[]
  sewaTransactions       SewaTransaction[]
  sewaEquipments         MasterSewaAlat[]
  masterIncentiveRates   MasterIncentiveRate[]
}

model Vehicle {
  id                 String                  @id @default(uuid())
  plate_number       String                  @unique
  vehicle_type       VehicleType
  code               String
  categoryId         String?
  category           VehicleCategory?        @relation(fields: [categoryId], references: [id])
  transactions       ProductionTransaction[]
  location           Location                @relation(fields: [locationId], references: [id])
  locationId         String
  rblExpenses        RblExpense[]

  // Dump Truck specifications
  dump_truck_size    String?                 // "BESAR" | "KECIL"
  capacity_cubic     Float?                  // Kapasitas bak (m³) spesifikasi referensi
  aggregateIncomings AggregateIncoming[]
  aggregateOutgoings AggregateOutgoing[]

  // Equipment & Vehicle Meter Specifications
  meter_type         String?                 @default("KM") // "KM" | "HM"
  merk_model         String?                 // e.g. "Sicoma 60m³/h", "Perkins 150 kVA", "Komatsu PC200-8"
  poItems            PoItem[]
  purchaseOrders     PurchaseOrder[]

  // Rental & Sewa Integration
  is_for_rent        Boolean                 @default(false) // Tag / flag unit tersedia untuk disewakan
  default_day_rate   Float?                  @default(0)     // Tarif sewa acuan per hari (Rp)
  rental_status      String?                 @default("Tersedia") // "Tersedia" | "Disewa" | "Maintenance" | "Nonaktif"
  rental_notes       String?                 // Catatan spesifikasi sewa
  sewaTransactions   SewaTransaction[]

  @@index([categoryId])
  @@index([is_for_rent])
}

model VehicleCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  code        String?
  description String?
  isSystem    Boolean   @default(false)
  vehicles    Vehicle[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Customer {
  id            String         @id @default(uuid())
  customer_name String
  address       String // Billing Address / Alamat Tagih
  status        CustomerStatus @default(Active)

  projects Project[] // 1 Customer punya banyak Project

  location   Location @relation("CustomerOwner", fields: [locationId], references: [id]) // Changed
  locationId String

  sharedLocations Location[] @relation("CustomerSharedLocations") // Added
  sewaTransactions SewaTransaction[]
  invoices         Invoice[]
}

model Project {
  id               String @id @default(uuid())
  name             String // Nama Proyek
  address          String // Lokasi Proyek Pengecoran
  default_distance Float // Memindahkan default_distance dari Customer
  tax_ppn          Float // Memindahkan tax_ppn dari Customer

  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String

  prices        ProjectPrice[] // Daftar harga per mutu untuk proyek ini
  transactions  ProductionTransaction[] // Transaksi sekarang mengarah ke Proyek
  invoices      Invoice[]
  deposits      Deposit[]
  concretePlans ConcretePlan[]

  sharedLocations Location[] @relation("ProjectSharedLocations")
  sewaTransactions SewaTransaction[]
}

model ProjectPrice {
  id              String          @id @default(uuid())
  project         Project         @relation(fields: [projectId], references: [id])
  projectId       String
  concreteQuality ConcreteQuality @relation(fields: [qualityId], references: [id])
  qualityId       String
  price           Float // Harga kesepakatan

  @@unique([projectId, qualityId]) // 1 Proyek hanya punya 1 harga untuk 1 mutu tertentu
}

model WorkItem {
  id            String                  @id @default(uuid())
  name          String                  @unique // e.g., Rigid, Kolom, Sloof
  transactions  ProductionTransaction[]
  concretePlans ConcretePlan[]
  location      Location                @relation(fields: [locationId], references: [id])
  locationId    String
}

model ConcreteQuality {
  id                   String                  @id @default(uuid())
  name                 String // e.g., K-225
  composition_sand     Float
  composition_stone_05 Float
  composition_stone_12 Float
  composition_stone_23 Float
  composition_cement   Float
  density_sand         Float?                  @default(1400) // Berat Jenis Pasir (Kg/m3)
  density_stone_05     Float?                  @default(1400) // Berat Jenis Ciping / Batu 0.5 (Kg/m3)
  density_stone_12     Float?                  @default(1450) // Berat Jenis Batu 1-2 (Kg/m3)
  density_stone_23     Float?                  @default(1450) // Berat Jenis Batu 2-3 (Kg/m3)
  transactions         ProductionTransaction[]
  projectPrices        ProjectPrice[] // Added opposite relation for ProjectPrice
  concretePlans        ConcretePlan[]
  location             Location                @relation(fields: [locationId], references: [id])
  locationId           String
}

model ProductionTransaction {
  id                String            @id @default(uuid())
  date              DateTime
  vehicle           Vehicle           @relation(fields: [vehicleId], references: [id])
  vehicleId         String
  driver            Employee          @relation("SopirRelation", fields: [driverId], references: [id])
  driverId          String
  concreteQuality   ConcreteQuality   @relation(fields: [qualityId], references: [id])
  qualityId         String
  workItem          WorkItem          @relation(fields: [workItemId], references: [id])
  workItemId        String
  volume_cubic      Float
  slump             String
  project           Project           @relation(fields: [projectId], references: [id])
  projectId         String
  cumulative_volume Float
  trip_sequence     Int               @default(1)
  status            TransactionStatus @default(Pending)
  createdBy         Employee          @relation("OperatorRelation", fields: [createdById], references: [id])
  createdById       String
  operator          Employee?         @relation("ProductionOperator", fields: [operatorId], references: [id])
  operatorId        String?
  location          Location          @relation(fields: [locationId], references: [id])
  locationId        String
  retase            Retase?
  invoiceItem       InvoiceItem?

  @@index([date])
  @@index([locationId, date])
  @@index([projectId])
  @@index([driverId])
  @@index([operatorId])
  @@index([status])
  @@index([vehicleId])
}

model MaterialIncoming {
  id              String         @id @default(uuid())
  date            DateTime
  material_type   MaterialType
  name            String // e.g., "Semen Tonasa", "Semen Bosowa"
  supplier        String
  tonnage         Float // Will be treated as KG
  delivery_note   String
  location        Location       @relation(fields: [locationId], references: [id])
  locationId      String

  // Kolom Harga & Satuan Beli
  unit_price      Float?         @default(0)
  total_price     Float?         @default(0)
  purchase_unit   String?        @default("KG")
  purchase_qty    Float?

  // Referensi PO Logistik (Opsional)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  poItemId        String?
  poItem          PoItem?        @relation(fields: [poItemId], references: [id])

  @@index([date])
  @@index([locationId, date])
  @@index([material_type])
  @@index([purchaseOrderId])
  @@index([poItemId])
}

model AggregateIncoming {
  id              String              @id @default(uuid())
  date            DateTime
  no_bon          String // No Bon / Surat Jalan
  driver_name     String // Nama Sopir (snapshot teks)
  plate_number    String // Plat Nomor Kendaraan (snapshot teks)
  volume_cubic    Float // Jumlah kubikasi riil dalam m³ (diinput manual)
  aggregate_type  AggregateType
  source_type     AggregateSourceType
  supplier        String? // Nama supplier (jika External)
  notes           String?
  location        Location            @relation(fields: [locationId], references: [id])
  locationId      String

  // Link to internal vehicle & driver for retase calculation (Internal only)
  vehicleId       String?
  vehicle         Vehicle?            @relation(fields: [vehicleId], references: [id])
  driverId        String?
  driver          Employee?           @relation("DriverAggregate", fields: [driverId], references: [id])
  dump_truck_size String?             // "BESAR" | "KECIL" (snapshot saat transaksi)
  distance_km     Float?              // Jarak tempuh (KM)
  rate_price      Float?              // Tarif per m³.km yang digunakan (Rp)
  retase_amount   Float?              // Total retase = volume_cubic * distance_km * rate_price
  is_retase_paid  Boolean             @default(false)

  createdAt       DateTime            @default(now())

  @@index([date])
  @@index([locationId, date])
  @@index([aggregate_type])
  @@index([vehicleId])
  @@index([driverId])
}

model AggregateOutgoing {
  id              String              @id @default(uuid())
  date            DateTime            @default(now())
  no_bon          String?             // No Bon / Surat Jalan Keluar
  aggregate_type  AggregateType
  volume_cubic    Float               // Jumlah kubikasi keluar / kuantitas barang
  unit            String?             @default("m³") // "m³" | "zak" | "ton" | "kg"

  // Nilai Finansial (Penjualan Komersial / Pemakaian Proyek)
  unit_price      Float?              @default(0) // Harga satuan (Rp)
  total_price     Float?              @default(0) // Total nilai penjualan / proyek (Rp)

  category        String              @default("PENJUALAN") // "PENJUALAN" | "INTERNAL_PROYEK" | "TRANSFER" | "KOREKSI_SUSUT" | "INTERNAL_PLANT" | "LAINNYA"
  recipient       String?             // Pembeli / Lokasi / Proyek Tujuan

  // Pengangkutan & Retase Dump Truck Internal
  transport_mode  String?             @default("BUYER") // "INTERNAL_DT" | "BUYER"
  vehicleId       String?
  vehicle         Vehicle?            @relation(fields: [vehicleId], references: [id])
  driverId        String?
  driver          Employee?           @relation("DriverAggregateOutgoing", fields: [driverId], references: [id])
  dump_truck_size String?             // "BESAR" | "KECIL" (snapshot saat transaksi)
  distance_km     Float?              // Jarak tempuh kirim (KM)
  rate_price      Float?              // Tarif retase per m³·km (Rp)
  retase_amount   Float?              // Total komisi retase = volume_cubic * distance_km * rate_price
  is_retase_paid  Boolean             @default(false)

  plate_number    String?             // Plat kendaraan pengangkut
  driver_name     String?             // Nama sopir pengangkut
  notes           String?             // Catatan keperluan / alasan pengeluaran
  location        Location            @relation(fields: [locationId], references: [id])
  locationId      String
  createdById     String?             // User pembuat
  createdAt       DateTime            @default(now())

  @@index([date])
  @@index([locationId, date])
  @@index([aggregate_type])
  @@index([category])
  @@index([vehicleId])
  @@index([driverId])
}

enum RetaseCalcMode {
  DISTANCE_ONLY
  DISTANCE_AND_VOLUME
}

model Retase {
  id                  String                @id @default(uuid())
  transaction         ProductionTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId       String                @unique
  driver              Employee              @relation("DriverRetase", fields: [driverId], references: [id])
  driverId            String
  calculated_distance Float
  volume              Float
  price_per_cubic_km  Float
  income_amount       Float
  calculation_mode    RetaseCalcMode?       @default(DISTANCE_ONLY)

  @@index([driverId])
}

model RetaseSetting {
  id                      String          @id @default(uuid())
  price_per_cubic_km      Float           // Harga dasar retase (Rp/KM atau Rp/M3/KM)
  calculation_mode        RetaseCalcMode  @default(DISTANCE_ONLY)
  operator_rate_per_cubic Float           @default(0) // Tarif insentif operator BP per m³ (Rp/m³)
  effective_from          DateTime        @default(now())
  location                Location        @relation(fields: [locationId], references: [id])
  locationId              String          @unique // One setting per branch
  updatedAt               DateTime        @updatedAt
}

model AggregateRetaseSetting {
  id                  String   @id @default(uuid())
  price_dt_besar      Float    @default(0) // Tarif Rp / m³.km DT Besar
  price_dt_kecil      Float    @default(0) // Tarif Rp / m³.km DT Kecil
  default_distance_km Float    @default(0) // Default jarak Quarry ke BP (KM)
  effective_from      DateTime @default(now())
  location            Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId          String   @unique // One setting per branch
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model MasterIncentiveRate {
  id             String    @id @default(uuid())
  nama_insentif  String    // e.g. "Insentif Operator BP", "Insentif Operator CP per Trip", "Insentif Operator Excavator"
  kategori_peran String    // "OPERATOR_BP", "OPERATOR_CP", "OPERATOR_ALAT_BERAT", "SOPIR_MIXER", "SOPIR_DT", "LAINNYA"
  formula_type   String    // "PER_M3", "PER_TRIP", "PER_JAM_HM", "PER_HARI", "PER_KM", "PER_M3_KM", "DT_TIERED"
  tarif_utama    Float     @default(0) // Nominal tarif dasar (Rp)
  tarif_sekunder Float?    @default(0) // Tarif tier 2 (misal untuk DT Kecil pada rumus DT)
  locationId     String?   // null = Berlaku Semua Cabang, atau spesifik id cabang
  location       Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  effective_date DateTime  // Tanggal Mulai Berlaku
  keterangan     String?
  isActive       Boolean   @default(true)
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([kategori_peran, locationId, effective_date])
  @@index([isActive])
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String // "EDIT" or "DELETE"
  entity     String // e.g., "ProductionTransaction"
  recordId   String // The ID of the affected record
  old_values String? // JSON stringified previous state
  new_values String? // JSON stringified new state (null if DELETED)
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  timestamp  DateTime @default(now())

  @@index([entity, recordId])
  @@index([timestamp])
  @@index([userId])
}

// ─── INVOICE SYSTEM ────────────────────────────────────────────────────────

model Invoice {
  id             String        @id @default(uuid())
  invoice_number String        @unique
  project        Project?      @relation(fields: [projectId], references: [id])
  projectId      String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  customerId     String?
  invoice_type   String        @default("READYMIX") // "READYMIX", "SEWA", "MIXED"
  issue_date     DateTime      @default(now())
  due_date       DateTime?
  period_start   DateTime?
  period_end     DateTime?
  status         InvoiceStatus @default(DRAFT)
  include_ppn    Boolean       @default(true)
  subtotal       Float
  tax_amount     Float         @default(0)
  total_amount   Float
  paid_amount    Float         @default(0)
  notes          String?
  cancel_reason  String? // Alasan pembatalan invoice
  cancelled_at   DateTime? // Waktu pembatalan
  items          InvoiceItem[]
  payments       Payment[]
  billingLogs    BillingLog[]
  location       Location      @relation(fields: [locationId], references: [id])
  locationId     String
  createdAt      DateTime      @default(now())

  @@index([locationId, status])
  @@index([issue_date])
  @@index([projectId])
  @@index([customerId])
  @@index([status])
}

model InvoiceItem {
  id                String                 @id @default(uuid())
  invoice           Invoice                @relation(fields: [invoiceId], references: [id])
  invoiceId         String
  transaction       ProductionTransaction? @relation(fields: [transactionId], references: [id])
  transactionId     String?                @unique
  sewaTransaction   SewaTransaction?       @relation(fields: [sewaTransactionId], references: [id])
  sewaTransactionId String?                @unique
  description       String?                // Keterangan / rincian item (misal sewa alat, dsb)
  item_type         String                 @default("READYMIX") // "READYMIX" | "SEWA"
  quantity          Float
  unit_price        Float
  subtotal          Float

  @@index([invoiceId])
  @@index([sewaTransactionId])
}

model Payment {
  id            String        @id @default(uuid())
  invoice       Invoice       @relation(fields: [invoiceId], references: [id])
  invoiceId     String
  payment_date  DateTime
  amount        Float
  method        PaymentMethod
  reference_no  String?
  proof_url     String?
  notes         String?
  is_cancelled  Boolean       @default(false) // Soft cancel
  cancel_reason String? // Alasan pembatalan
  cancelled_at  DateTime? // Waktu pembatalan
  billingLogs   BillingLog[]
  createdAt     DateTime      @default(now())

  @@index([invoiceId])
  @@index([payment_date])
  @@index([is_cancelled])
}

model Deposit {
  id          String   @id @default(uuid())
  project     Project  @relation(fields: [projectId], references: [id])
  projectId   String
  date        DateTime @default(now())
  amount      Float
  description String
  reference   String?
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([date])
}

// Immutable billing audit trail — never deleted
model BillingLog {
  id          String        @id @default(uuid())
  action      BillingAction
  invoice     Invoice?      @relation(fields: [invoiceId], references: [id])
  invoiceId   String?
  payment     Payment?      @relation(fields: [paymentId], references: [id])
  paymentId   String?
  actorId     String
  description String
  metadata    String?
  createdAt   DateTime      @default(now())

  @@index([invoiceId])
  @@index([paymentId])
  @@index([createdAt])
}

// ─── PLANNING PENGECORAN ────────────────────────────────────────────────────

model ConcretePlan {
  id              String          @id @default(uuid())
  date            DateTime // Tanggal rencana pengecoran
  project         Project         @relation(fields: [projectId], references: [id])
  projectId       String
  concreteQuality ConcreteQuality @relation(fields: [qualityId], references: [id])
  qualityId       String
  workItem        WorkItem        @relation(fields: [workItemId], references: [id])
  workItemId      String
  volume_plan     Float // Volume rencana (m³)
  notes           String? // Catatan tambahan
  status          PlanStatus      @default(Planned)
  location        Location        @relation(fields: [locationId], references: [id])
  locationId      String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([date])
  @@index([locationId, date])
  @@index([projectId])
  @@index([status])
}

// ─── LOGISTIK & PERALATAN ───────────────────────────────────────────────────

enum PoPaymentMethod {
  CASH
  CREDIT
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

model PoCompanyGroup {
  id                       String             @id @default(uuid())
  name                     String
  kode_cabang              String // Singkatan untuk nomor PO, e.g. "RPJ"
  kota                     String // Kota tanda tangan
  address                  String? // Alamat KOP Surat
  email                    String?
  pimpinan_default         String? // Nama pimpinan default
  kepala_peralatan_default String? // Nama kepala peralatan default
  jabatan_kepala_default   String? // Jabatan kepala peralatan, misal: "Kepala Peralatan"
  logo_url                 String? // Path logo perusahaan untuk KOP surat
  
  defaultCeoId             String? // default CEO signer
  defaultFvpId             String? // default FVP signer
  defaultCeo               User?   @relation("CompanyCeo", fields: [defaultCeoId], references: [id])
  defaultFvp               User?   @relation("CompanyFvp", fields: [defaultFvpId], references: [id])

  projects                 PoCompanyProject[]
  purchaseOrders           PurchaseOrder[]
  createdAt                DateTime           @default(now())
}

model PoCompanyProject {
  id             String         @id @default(uuid())
  name           String // Nama / lokasi proyek
  kode_proyek    String? // Kode singkat opsional, e.g. "005"
  companyGroup   PoCompanyGroup @relation(fields: [companyGroupId], references: [id])
  companyGroupId String
  createdAt      DateTime       @default(now())
}

model PoCategory {
  id             String          @id @default(uuid())
  name           String
  kode_kategori  String          @unique // e.g. "ATK", "SPR", "BBM"
  require_hm_km  Boolean         @default(false)
  masterItems    MasterItem[]
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
}

model Supplier {
  id          String       @id @default(uuid())
  name        String
  address     String?
  contact     String?
  masterItems MasterItem[]
  createdAt   DateTime     @default(now())
}

model MasterItem {
  id          String     @id @default(uuid())
  kode_barang String     @unique
  name        String
  part_number String?
  merk        String?
  satuan      String // PCS, SET, LTR, dll
  harga       Float // Harga satuan default
  supplier    Supplier   @relation(fields: [supplierId], references: [id])
  supplierId  String
  category    PoCategory @relation(fields: [categoryId], references: [id])
  categoryId  String
  poItems     PoItem[]
  priceHistories MasterItemPriceHistory[]
  createdAt   DateTime   @default(now())

  @@index([name])
  @@index([categoryId])
  @@index([supplierId])
}

model MasterItemPriceHistory {
  id            String     @id @default(uuid())
  masterItem    MasterItem @relation(fields: [masterItemId], references: [id], onDelete: Cascade)
  masterItemId  String

  oldPrice      Float
  newPrice      Float
  priceDiff     Float      // newPrice - oldPrice
  percentage    Float      // ((newPrice - oldPrice) / oldPrice) * 100

  effectiveDate DateTime   @default(now())
  reason        String?

  updatedById   String?
  updatedBy     User?      @relation("PriceHistoryUpdatedBy", fields: [updatedById], references: [id])

  createdAt     DateTime   @default(now())

  @@index([masterItemId])
  @@index([effectiveDate])
}

model PurchaseOrder {
  id             String   @id @default(uuid())
  po_number      String   @unique // Auto-generated: 001/RPJ/ATK/03/2026
  tanggal_terbit DateTime

  companyGroup     PoCompanyGroup @relation(fields: [companyGroupId], references: [id])
  companyGroupId   String
  companyProjectId String? // Opsional, tujuan/lokasi proyek

  category   PoCategory @relation(fields: [categoryId], references: [id])
  categoryId String

  supplierId String

  // Tanda tangan
  pimpinan         String // Nama pimpinan (bisa di-override dari default)
  kepala_peralatan String // Nama pemesan / kepala peralatan
  jabatan_kepala   String? // Label jabatan kepala peralatan (dinamis)
  pembuat_admin    String // Nama admin pembuat

  metode_pembayaran PoPaymentMethod @default(CREDIT)
  km_hm_kendaraan   String? // Opsional, untuk kategori SPR

  // Terikat cabang (opsional)
  location   Location? @relation(fields: [locationId], references: [id])
  locationId String?

  // Terikat kendaraan / alat (opsional)
  vehicleId  String?
  vehicle    Vehicle?  @relation(fields: [vehicleId], references: [id])

  status PurchaseOrderStatus @default(DRAFT)
  notes  String?

  // Multi-Level Approval Tracker
  ceoId         String?
  fvpId         String?
  ceoApprovedAt DateTime?
  fvpApprovedAt DateTime?
  ceo           User? @relation("PoCeo", fields: [ceoId], references: [id])
  fvp           User? @relation("PoFvp", fields: [fvpId], references: [id])

  // Approval Execution Tracker
  isBypassed         Boolean   @default(false)
  approvalChannel    String?   // "MOBILE" | "WEB"
  approvedById       String?
  approvedBy         User?     @relation("PoApprovedBy", fields: [approvedById], references: [id])
  ceoApprovedById    String?
  ceoApprovedBy      User?     @relation("PoCeoApprovedBy", fields: [ceoApprovedById], references: [id])
  ceoApprovalChannel String?   // "MOBILE" | "WEB"
  fvpApprovedById    String?
  fvpApprovedBy      User?     @relation("PoFvpApprovedBy", fields: [fvpApprovedById], references: [id])
  fvpApprovalChannel String?   // "MOBILE" | "WEB"
  fvpSignatureUrl    String?   // Gambar TTD FVP
  fvpNotes           String?   // Catatan FVP

  ceoSignatureUrl    String?   // Gambar TTD CEO
  ceoNotes           String?   // Catatan CEO

  // Submission & Rejection Tracking
  submittedAt        DateTime?
  submittedById      String?
  submittedBy        User?     @relation("PoSubmittedBy", fields: [submittedById], references: [id])
  rejectionReason    String?
  rejectedAt         DateTime?
  rejectedById       String?
  rejectedBy         User?     @relation("PoRejectedBy", fields: [rejectedById], references: [id])

  pic_name  String?
  pic_phone String?

  is_for_bp         Boolean            @default(false)
  materialIncomings MaterialIncoming[]

  items     PoItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  @@index([tanggal_terbit])
  @@index([companyGroupId])
  @@index([categoryId])
  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
  @@index([locationId])
  @@index([is_for_bp])
  @@index([status, tanggal_terbit])
}

model PoItem {
  id              String        @id @default(uuid())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  masterItem      MasterItem    @relation(fields: [masterItemId], references: [id])
  masterItemId    String
  quantity        Float
  harga_satuan    Float // Snapshot harga saat PO dibuat
  keterangan      String? // e.g. "Plat DT 8258 RI"
  subtotal        Float

  // Unit Kendaraan / Alat & KM/HM
  vehicleId       String?
  vehicle         Vehicle?      @relation(fields: [vehicleId], references: [id])
  km_hm           String?       // Nilai KM atau HM saat sparepart dipesan

  materialIncomings MaterialIncoming[]

  @@index([purchaseOrderId])
  @@index([masterItemId])
  @@index([vehicleId])
}

enum RblStatus {
  OPEN
  CLOSED
}

model RblBudget {
  id           String          @id @default(uuid())
  code         String          @unique // e.g. "RBL-SRG-2026-03"
  periodMonth  Int             // 1 - 12
  periodYear   Int             // e.g. 2026
  receivedDate DateTime        // Tanggal penerimaan budget
  amount       Float           // Nominal budget dari HO
  notes        String?         // Catatan sumber dana / rekening
  status       RblStatus       @default(OPEN)

  closedAt     DateTime?
  closedById   String?
  closedBy     User?           @relation("RblBudgetClosedBy", fields: [closedById], references: [id])
  closeNotes   String?

  location     Location        @relation(fields: [locationId], references: [id])
  locationId   String

  createdById  String
  createdBy    User            @relation("RblBudgetCreatedBy", fields: [createdById], references: [id])

  expenses     RblExpense[]
  attachments  RblAttachment[]

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([locationId, status])
  @@index([periodYear, periodMonth])
}

model RblExpense {
  id              String    @id @default(uuid())
  budgetId        String
  budget          RblBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  date            DateTime
  itemDescription String
  
  categoryId      String?
  categoryRef     RblCategory? @relation(fields: [categoryId], references: [id])
  category        String? // Snapshot nama kategori

  quantity        Float     @default(1)
  unit            String    @default("Pcs")
  unitPrice       Float     @default(0)
  amount          Float     // Total = quantity * unitPrice
  receiptNo       String?
  notes           String?

  vehicleId       String?
  vehicle         Vehicle?  @relation(fields: [vehicleId], references: [id])
  kmMeter         Float?    // Catatan KM / HM saat pengisian

  createdById     String
  createdBy       User      @relation("RblExpenseCreatedBy", fields: [createdById], references: [id])

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([budgetId, date])
  @@index([categoryId])
  @@index([vehicleId])
}

model RblAttachment {
  id           String    @id @default(uuid())
  budgetId     String
  budget       RblBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  date         DateTime?
  fileUrl      String
  fileName     String
  fileSize     Int?
  caption      String?

  uploadedById String
  uploadedBy   User      @relation("RblAttachmentUploadedBy", fields: [uploadedById], references: [id])

  createdAt    DateTime  @default(now())

  @@index([budgetId])
}

model RblCategory {
  id               String       @id @default(uuid())
  name             String       @unique
  description      String?
  requireVehicleKm Boolean      @default(false)
  isSystem         Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  expenses         RblExpense[]
}

// ─── SEWA ALAT / KENDARAAN (RENTAL EQUIPMENT) ───────────────────────────────

model DriverCategory {
  id          String     @id @default(uuid())
  name        String     @unique // e.g. "Sopir Mixer", "Sopir Dump Truck", "Operator Concrete Pump", "Operator Excavator", "Operator Crane"
  code        String?    // e.g. "MIX", "DT", "CP", "EXC"
  description String?
  isSystem    Boolean    @default(false)
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model MasterSewaAlat {
  id               String            @id @default(uuid())
  kode_alat        String            @unique // e.g. CP-01, EXC-01, CR-01, DT-01
  nama_alat        String            // e.g. Concrete Pump Sany 37m, Excavator Komatsu PC200
  kategori         String            // e.g. Concrete Pump, Excavator, Crane, Bulldozer, Wheel Loader, Dump Truck, Lainnya
  merk_model       String?           // e.g. Sany HBT60, Komatsu PC200-8
  nomor_seri_plat  String?           // Plat No Kendaraan atau No. Seri Unit
  default_day_rate Float?            @default(0) // Referensi tarif sewa harian (Rp)
  status           String            @default("Tersedia") // Tersedia, Disewa, Maintenance, Nonaktif
  keterangan       String?           // Catatan kondisi / kapasitas / spesifikasi
  locationId       String?
  location         Location?         @relation(fields: [locationId], references: [id])
  transactions     SewaTransaction[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([locationId])
  @@index([kategori])
  @@index([status])
}

model SewaTransaction {
  id            String         @id @default(uuid())
  sewa_number   String         @unique // Auto-generated: SWA/2026/03/001
  date          DateTime       @default(now()) // Tanggal DO / transaksi dibuat

  customerId    String
  customer      Customer       @relation(fields: [customerId], references: [id])

  projectId     String?
  project       Project?       @relation(fields: [projectId], references: [id])
  lokasi_proyek String?        // Catatan teks alamat/lokasi proyek

  equipmentId   String?
  equipment     MasterSewaAlat? @relation(fields: [equipmentId], references: [id])

  vehicleId     String?
  vehicle       Vehicle?        @relation(fields: [vehicleId], references: [id])

  operatorId    String
  operator      Employee       @relation("OperatorSewaRelation", fields: [operatorId], references: [id])

  date_mode     String         @default("RANGE") // "RANGE" (berurutan) atau "DATES" (tidak berurutan / acak)
  start_date    DateTime       // Tanggal mulai
  end_date      DateTime       // Tanggal selesai
  rental_dates  String         // JSON Array tanggal string: ["2026-03-01", "2026-03-05", ...]
  total_days    Int            // Total jumlah hari sewa

  price_per_day Float          @default(0) // Free input harga per hari (opsional)
  total_price   Float          @default(0) // Free input total harga sewa (Grand Total)

  // Pajak PPN
  is_ppn        Boolean        @default(false)
  ppn_mode      String         @default("NON_PPN") // "NON_PPN" | "INCLUDE" | "EXCLUDE"
  ppn_rate      Float?         @default(11)        // Persentase PPN (%)
  dpp_amount    Float?         @default(0)         // Dasar Pengenaan Pajak (Rp)
  ppn_amount    Float?         @default(0)         // Nilai Pajak PPN (Rp)

  status        String         @default("Active") // "Pending", "Active", "Completed", "Cancelled"
  notes         String?        // Instruksi khusus / catatan pekerjaan

  locationId    String
  location      Location       @relation(fields: [locationId], references: [id])

  invoiceItem   InvoiceItem?

  createdById   String?        // Employee ID pembuat transaksi
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([date])
  @@index([locationId, date])
  @@index([customerId])
  @@index([equipmentId])
  @@index([vehicleId])
  @@index([operatorId])
  @@index([status])
}


